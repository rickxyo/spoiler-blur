{
  "manifest_version": 3,
  "name": "SpoilerBlur",
  "version": "2.3.0",
  "description": "Borra vídeos e posts do YouTube e do X sobre os temas que você escolher.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpoilerBlur",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["storage.js", "core.js", "youtube.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["storage.js", "core.js", "x.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
